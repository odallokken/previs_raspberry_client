[Unit]
Description=PulseAudio sound server for previs-client
Documentation=https://github.com/odallokken/previs_raspberry_client
# previs-client runs as a headless system user with no login session, so there
# is no per-user PulseAudio daemon for it to talk to.  Without this unit the
# Pulse SDK logs "[pulse:pulse] Failed to connect: Connection refused" and then
# falls back to raw ALSA, which usually fails too ("Got no caps from device").
#
# The daemon deliberately runs as the *same* user as previs-client (and not in
# PulseAudio's "--system" mode, which upstream discourages and which needs the
# extra 'pulse'/'pulse-access' plumbing): the client then owns the socket it
# connects to, so no cookie or group based authentication is involved.
After=sound.target
Before=previs-client.service

[Service]
Type=notify
User=previs
Group=previs
UMask=0077

# The socket lives in the runtime directory that previs-client also uses, so
# both units must agree on it.  'RuntimeDirectoryPreserve' keeps the directory
# (and therefore the client's XDG_RUNTIME_DIR) alive across restarts of either
# service.
RuntimeDirectory=previs-client
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment="XDG_RUNTIME_DIR=/run/previs-client"

# PulseAudio wants a home directory for its configuration and cookie; the
# 'previs' system user has none, so give it a private one.
StateDirectory=previs-client
Environment="HOME=/var/lib/previs-client"
Environment="XDG_CONFIG_HOME=/var/lib/previs-client/.config"

# --exit-idle-time=-1 : never exit, even while previs-client is reconnecting.
ExecStart=/usr/bin/pulseaudio --daemonize=no --exit-idle-time=-1 --log-target=journal

Restart=always
RestartSec=5s

# Access to the sound cards.
SupplementaryGroups=audio video render

[Install]
WantedBy=multi-user.target
