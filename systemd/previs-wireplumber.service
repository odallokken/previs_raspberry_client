[Unit]
Description=WirePlumber session manager for previs-client
Documentation=https://github.com/odallokken/previs_raspberry_client
# PipeWire itself only provides the graph; without a session manager no ALSA
# card or USB webcam is ever turned into a node, so the SDK sees no microphone
# and no speaker.
After=previs-pipewire.service
Requires=previs-pipewire.service
Before=previs-client.service

[Service]
Type=simple
User=previs
Group=previs
UMask=0077

RuntimeDirectory=previs-client
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment="XDG_RUNTIME_DIR=/run/previs-client"

StateDirectory=previs-client
Environment="HOME=/var/lib/previs-client"
Environment="XDG_CONFIG_HOME=/var/lib/previs-client/.config"
Environment="XDG_STATE_HOME=/var/lib/previs-client/.local/state"

ExecStart=/usr/bin/wireplumber

Restart=always
RestartSec=2s

SupplementaryGroups=audio video render

[Install]
WantedBy=multi-user.target
