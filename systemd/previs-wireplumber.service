[Unit]
Description=WirePlumber session manager for previs-client
Documentation=https://github.com/odallokken/previs_raspberry_client
# PipeWire itself only provides the graph; without a session manager no ALSA
# card or USB webcam is ever turned into a node, so the SDK sees no microphone
# and no speaker.
After=previs-pipewire.service
Requires=previs-pipewire.service
Before=previs-client.service

[Service]
Type=simple
User=previs
Group=previs
UMask=0077

RuntimeDirectory=previs-client
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment="XDG_RUNTIME_DIR=/run/previs-client"

StateDirectory=previs-client
Environment="HOME=/var/lib/previs-client"
Environment="XDG_CONFIG_HOME=/var/lib/previs-client/.config"
Environment="XDG_STATE_HOME=/var/lib/previs-client/.local/state"

# WirePlumber talks to a D-Bus session bus (for reservation of the ALSA cards
# and for the portal/rt modules).  A headless system user has none, and D-Bus
# cannot autolaunch one without an X11 session, so WirePlumber aborts during
# start-up:
#
#     Failed to connect to session bus: Unable to autolaunch a dbus-daemon
#         without a $DISPLAY for X11
#     Error acquiring bus address: Cannot autolaunch D-Bus without X11 $DISPLAY
#     previs-wireplumber.service: Main process exited, code=exited,
#         status=70/SOFTWARE
#
# systemd then restarts it every few seconds, and because no session manager
# ever stays up long enough to turn the sound cards into PipeWire nodes, the
# only devices the SDK sees are "Dummy Output" and "Monitor of Dummy Output".
#
# 'dbus-run-session' starts a private bus, exports DBUS_SESSION_BUS_ADDRESS into
# the child and tears the bus down again when WirePlumber exits.  It comes from
# the 'dbus-bin' package, which scripts/install.sh installs.
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/wireplumber

Restart=always
RestartSec=2s

SupplementaryGroups=audio video render

[Install]
WantedBy=multi-user.target
